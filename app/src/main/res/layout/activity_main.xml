<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".activities.MainActivity">

    <!-- Top Title Bar -->
    <LinearLayout
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_white_text"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="4dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <ImageView
                    android:id="@+id/printer_indicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    app:srcCompat="@android:drawable/ic_menu_report_image"
                    app:tint="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/sheets_indicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@android:drawable/stat_sys_upload"
                    app:tint="@android:color/darker_gray" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/amrita_cafe_title_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amma_font"
                            android:text="Amrita Cafe"
                            android:textColor="@color/black"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/app_version_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="(80102)"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tabletNameMainTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unnamed tablet"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                    android:id="@+id/user_TV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jayadev @ Amma"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:visibility="gone" />
        </LinearLayout>

        <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:onClick="openSettings"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Menu Controls (Menu Category Spinner, Price Toggle, Short/Long Toggle) -->
    <LinearLayout
            android:id="@+id/menu_controls"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:baselineAligned="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu:"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <Spinner
                    android:id="@+id/menu_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="0dp"
                    android:layout_margin="0dp"
                    android:background="@drawable/background_other_buttons" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:orientation="vertical"
                android:layout_marginEnd="2dp">

            <TextView
                    android:id="@+id/price_toggle_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price:"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <Button
                    android:id="@+id/price_toggle_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/background_other_buttons"
                    android:onClick="togglePriceVisibility"
                    android:padding="0dp"
                    android:text="On"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/short_toggle_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Short:"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <Button
                    android:id="@+id/short_long_toggle_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/background_other_buttons"
                    android:onClick="toggleShortLongName"
                    android:padding="0dp"
                    android:text="Off"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Guideline separating Menu Grid (above) and Current Orders (below) -->
    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.65" />

    <!-- Menu Items Grid (Upper ~55% of screen) -->
    <GridView
            android:id="@+id/menuGridView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:clipToPadding="false"
            android:gravity="center_horizontal|center_vertical"
            android:horizontalSpacing="4dp"
            android:numColumns="4"
            android:paddingTop="2dp"
            android:paddingBottom="50dp"
            android:verticalSpacing="4dp"
            app:layout_constraintBottom_toTopOf="@+id/guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/menu_controls"
            tools:listitem="@layout/item_menu" />

    <!-- Cafe Item button floating at bottom-right of menu grid -->
    <Button
            android:id="@+id/order_button2"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/background_payment"
            android:onClick="cafeOrder"
            android:padding="0dp"
            android:text="Cafe Item"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/guideline"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Order Info Layout (Order #, order_number_TV) -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/order_info_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/background_white_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guideline">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:text="Order"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/order_number_TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Orders List View (Current order items) -->
    <ListView
            android:id="@+id/order_ListView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:paddingEnd="4dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/order_info_layout"
            tools:listitem="@layout/item_order" />

    <!-- Sum / Total Cost Row -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/background_white_text"
            app:layout_constraintBottom_toTopOf="@+id/order_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <TextView
                android:id="@+id/sum_label_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sum"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="8dp" />

        <TextView
                android:id="@+id/total_cost_TV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/textView2"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="₹"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Cancel Order Button -->
    <ImageButton
            android:id="@+id/button_cancel"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/background_other_buttons"
            android:onClick="cancelOrder"
            app:layout_constraintBottom_toTopOf="@+id/history_button"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_delete_forever_black_24dp" />

    <!-- Big Order Button -->
    <Button
            android:id="@+id/order_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/background_payment"
            android:onClick="orderButtonPressed"
            android:text="Order"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/history_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/button_cancel" />

    <!-- Order History Button -->
    <Button
            android:id="@+id/history_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/background_other_buttons"
            android:onClick="openHistoryDialog"
            android:text="Order History"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <!-- Payment Dialog Overlay -->
    <include
            android:id="@+id/include_payment"
            layout="@layout/dialog_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Easter Egg Container (Amma Photo) -->
    <FrameLayout
            android:id="@+id/easter_egg_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="100dp"
            android:background="#99000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
        <ImageView
                android:id="@+id/amma_image_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/amma_face_splash" />

        <ImageButton
                android:id="@+id/close_amma_easter_egg_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/background_other_buttons"
                android:src="@drawable/ic_clear_black_24dp"
                android:contentDescription="Close"
                android:elevation="10dp" />
    </FrameLayout>

    <!-- Eternal Joy Easter Egg -->
    <FrameLayout
        android:id="@+id/eternal_joy_container"
        android:layout_width="150dp"
        android:layout_height="90dp"
        android:visibility="gone"
        android:elevation="110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <FrameLayout 
            android:id="@+id/eternal_joy_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_menu_item"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="14dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:typeface="serif"
                android:textSize="20sp"
                android:text="Eternal\nJoy" />

            <TextView
                android:id="@+id/eternal_joy_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="2dp"
                android:alpha="0.7"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="italic"
                android:text="₹0" />
        </FrameLayout>
    </FrameLayout>

    <!-- Darshan Mini Game -->
    <FrameLayout
        android:id="@+id/darshan_game_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <edu.amrita.amritacafe.activities.DarshanGameView
            android:id="@+id/darshan_game_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
        <Button
            android:id="@+id/close_darshan_game_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/background_other_button_darkers"
            android:padding="8dp"
            android:text="Chai is coming!"
            android:textColor="@color/black" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>