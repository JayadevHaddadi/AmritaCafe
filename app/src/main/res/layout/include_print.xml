<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/kitchen_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/kitchen_text_TV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="Kitchen Printer:"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/kitchen_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/kitchen_text_TV"
            app:layout_constraintStart_toEndOf="@+id/kitchen_text_TV"
            app:layout_constraintTop_toTopOf="@+id/kitchen_text_TV" />

        <Button
            android:id="@+id/kitchen_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/background_login_buttons"
            android:paddingHorizontal="8dp"
            android:text="Retry"
            android:textColor="@color/white"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/kitchen_text_TV"
            app:layout_constraintStart_toEndOf="@+id/kitchen_progress"
            app:layout_constraintTop_toTopOf="@+id/kitchen_text_TV"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/kitchen_done"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/kitchen_text_TV"
            app:layout_constraintStart_toStartOf="@+id/kitchen_progress"
            app:layout_constraintTop_toTopOf="@+id/kitchen_text_TV"
            app:srcCompat="@drawable/ic_done_black_24dp"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/kitchen_error"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/kitchen_text_TV"
            app:layout_constraintStart_toStartOf="@+id/kitchen_done"
            app:layout_constraintTop_toTopOf="@+id/kitchen_text_TV"
            app:srcCompat="@drawable/ic_error_black_24dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/receipt_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kitchen_layout">

        <TextView
            android:id="@+id/receipt_text_TV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Receipt Printer:"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/receipt_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/receipt_text_TV"
            app:layout_constraintStart_toEndOf="@+id/receipt_text_TV"
            app:layout_constraintTop_toTopOf="@+id/receipt_text_TV" />

        <Button
            android:id="@+id/receipt_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/background_login_buttons"
            android:paddingHorizontal="8dp"
            android:text="Retry"
            android:textColor="@color/white"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/receipt_text_TV"
            app:layout_constraintStart_toEndOf="@+id/receipt_progress"
            app:layout_constraintTop_toTopOf="@+id/receipt_text_TV"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/receipt_done"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/receipt_text_TV"
            app:layout_constraintStart_toStartOf="@+id/receipt_progress"
            app:layout_constraintTop_toTopOf="@+id/receipt_text_TV"
            app:srcCompat="@drawable/ic_done_black_24dp"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/receipt_error"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/receipt_text_TV"
            app:layout_constraintStart_toStartOf="@+id/receipt_done"
            app:layout_constraintTop_toTopOf="@+id/receipt_text_TV"
            app:srcCompat="@drawable/ic_error_black_24dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>