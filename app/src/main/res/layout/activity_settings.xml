<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context="edu.amrita.amritacafe.activities.SettingsActivity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/settings_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/versionInfoTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Current Version: 8.0 (80101)" />
    </LinearLayout>

    <!-- Legacy hidden views kept for ViewBinding compatibility -->
    <TextView
        android:id="@+id/textViewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/sheetSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/refreshButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textViewError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Workflow & Destinations -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printer Workflow &amp; Destinations"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default Mode:"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/mode_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#263238" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receipt Printer Destination:"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/receipt_destination_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#263238" />

            <TextView
                android:id="@+id/kitchen_printer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kitchen Printer Destination:"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/kitchen_destination_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#263238" />

            <!-- Printer 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printer 1 (Wi-Fi 1 / Bluetooth 1)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi / LAN 1 IP Address:"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/receipt_ip_ET"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="192.168.0.10"
                    android:inputType="text" />
                <Button
                    android:id="@+id/test_wifi1_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth Printer 1:"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/bluetooth_ET"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Select a paired printer"
                    android:focusable="false"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:inputType="none" />
                <Button
                    android:id="@+id/pair_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select"
                    style="?android:attr/buttonStyleSmall" />
                <Button
                    android:id="@+id/test_bluetooth_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printer 1 Paper Size:"
                android:layout_marginTop="6dp"/>
            <Spinner
                android:id="@+id/bluetooth_paper_size_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#263238" />

            <!-- Printer 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printer 2 (Wi-Fi 2 / Bluetooth 2)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi / LAN 2 IP Address:"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/kitchen_ip_ET"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="192.168.0.11"
                    android:inputType="text" />
                <Button
                    android:id="@+id/test_wifi2_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth Printer 2:"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/bluetooth2_ET"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Select a paired printer"
                    android:focusable="false"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:inputType="none" />
                <Button
                    android:id="@+id/pair_button2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select"
                    style="?android:attr/buttonStyleSmall" />
                <Button
                    android:id="@+id/test_bluetooth2_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printer 2 Paper Size:"
                android:layout_marginTop="6dp"/>
            <Spinner
                android:id="@+id/bluetooth2_paper_size_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#263238" />

            <!-- Print Font Scaling & Receipt Test -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Print Font Scaling"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/font_large_minus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
                <TextView
                    android:id="@+id/font_large_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Large Text: 2x"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/font_large_plus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/font_small_minus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
                <TextView
                    android:id="@+id/font_small_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Small Text: 1x"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/font_small_plus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <Button
                android:id="@+id/test_receipt_print_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_other_buttons"
                android:text="Test Receipt Print"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <!-- Kitchen Print Margins & Test -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kitchen Print Margins"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/margin_before_minus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
                <TextView
                    android:id="@+id/margin_before_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Feed Before: 0 lines"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/margin_before_plus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/margin_after_minus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
                <TextView
                    android:id="@+id/margin_after_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Feed After: 2 lines"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/margin_after_plus_btn"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="18sp"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <Button
                android:id="@+id/test_kitchen_print_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_other_buttons"
                android:text="Test Kitchen Print"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/raw_socket_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Use Raw TCP (Port 9100) - For Generic/Hoin" />

            <CheckBox
                android:id="@+id/printAmmaQuoteCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Print Amma Quote on Receipts" />

            <!-- Tablet & Layout -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tablet &amp; Layout"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tablet Name:"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/tablet_name_ET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Counter 1, Kitchen"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Columns (Landscape / Horizontal):"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/column_numbers_ET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="8"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Columns (Portrait / Vertical):"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/column_numbers_portrait_ET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="4"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Order Number:"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/current_order_number_ET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Number Range:"
                android:layout_marginTop="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/range_from_ET"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="1"
                    android:inputType="number" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" to "
                    android:padding="8dp"/>
                <EditText
                    android:id="@+id/range_to_ET"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="999"
                    android:inputType="number" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Options"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <CheckBox
                android:id="@+id/testingCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Testing Mode (Disable actual printing)" />

            <CheckBox
                android:id="@+id/betaUpdatesCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Receive Beta Updates" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>